BS_:

BU_: MainHelm Flybridge PortActuator StbdActuator

VAL_TABLE_ GearCode 255 "Ahead" 1 "Astern" 0 "Neutral" ;
VAL_TABLE_ ActuatorCode 192 "Neutral_C0" 76 "Shifting_4C" 72 "AsternEngaged_48" 68 "AheadEngaged_44" 64 "Booting_40" ;
VAL_TABLE_ NmtState 127 "PreOperational" 5 "Operational" 4 "Stopped" 0 "BootUp" ;


BO_ 385 Station1_MainHelm: 7 MainHelm
 SG_ Flag_Command : 0|1@1+ (1,0) [0|1] "" PortActuator,StbdActuator,Flybridge
 SG_ Flag_WarmUp : 1|1@1+ (1,0) [0|1] "" PortActuator,StbdActuator,Flybridge
 SG_ Flag_Bit2 : 2|1@1+ (1,0) [0|1] "" Flybridge
 SG_ Flag_Sync : 3|1@1+ (1,0) [0|1] "" PortActuator,StbdActuator,Flybridge
 SG_ Flag_Unknown4_5 : 4|2@1+ (1,0) [0|3] "" Vector__XXX
 SG_ Flag_Always1 : 6|1@1+ (1,0) [1|1] "" Vector__XXX
 SG_ Flag_Unknown7 : 7|1@1+ (1,0) [0|1] "" Vector__XXX
 SG_ GearPort : 8|8@1+ (1,0) [0|255] "" PortActuator,Flybridge
 SG_ ThrottlePort : 16|8@1+ (1,0) [0|100] "%" PortActuator,Flybridge
 SG_ Reserved3 : 24|8@1+ (1,0) [0|0] "" Vector__XXX
 SG_ GearStbd : 32|8@1+ (1,0) [0|255] "" StbdActuator,Flybridge
 SG_ ThrottleStbd : 40|8@1+ (1,0) [0|100] "%" StbdActuator,Flybridge
 SG_ Reserved6 : 48|8@1+ (1,0) [0|0] "" Vector__XXX

BO_ 642 Station2_Flybridge: 7 Flybridge
 SG_ Flag_Command : 0|1@1+ (1,0) [0|1] "" PortActuator,StbdActuator,MainHelm
 SG_ Flag_WarmUp : 1|1@1+ (1,0) [0|1] "" PortActuator,StbdActuator,MainHelm
 SG_ Flag_Bit2 : 2|1@1+ (1,0) [0|1] "" MainHelm
 SG_ Flag_Sync : 3|1@1+ (1,0) [0|1] "" PortActuator,StbdActuator,MainHelm
 SG_ Flag_Unknown4_5 : 4|2@1+ (1,0) [0|3] "" Vector__XXX
 SG_ Flag_Always1 : 6|1@1+ (1,0) [1|1] "" Vector__XXX
 SG_ Flag_Unknown7 : 7|1@1+ (1,0) [0|1] "" Vector__XXX
